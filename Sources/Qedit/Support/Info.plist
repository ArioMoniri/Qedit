<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Qedit</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHumanReadableCopyright</key>
	<string>Qedit — non-destructive find/edit for any file. © 2026 Ariorad Moniri.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Qedit asks Finder which file is selected so it can open it for editing with the global hotkey.</string>
	<!-- Sparkle auto-updater: signed appcast feed + EdDSA public key. -->
	<key>SUFeedURL</key>
	<string>https://github.com/ArioMoniri/Qedit/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>WJW6oDc04x7UBySwM3UPsuzgcyJafp+682VWdVNSt/g=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Custom URL scheme used by the Quick Action / Service to hand a file to the editor. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ariomoniri.Qedit.open</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>qedit</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
