<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Qedit Preview</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).PreviewViewController</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>QLSupportsSearchableItems</key>
			<false/>
			<!--
			  ONLY non-system UTIs. We deliberately omit Apple-owned rich-preview types
			  (com.adobe.pdf, public.jpeg, public.png, public.tiff, public.html, public.rtf)
			  and the broad public.plain-text, so we never fight Apple's built-in previews.
			-->
			<key>QLSupportedContentTypes</key>
			<array>
				<!-- Markdown -->
				<string>net.daringfireball.markdown</string>
				<!-- Logs -->
				<string>public.log</string>
				<!-- Source code (Apple shows these as flat text; we add highlighting) -->
				<string>public.source-code</string>
				<string>public.shell-script</string>
				<string>public.python-script</string>
				<string>public.ruby-script</string>
				<string>public.perl-script</string>
				<string>public.php-script</string>
				<string>com.netscape.javascript-source</string>
				<string>public.swift-source</string>
				<string>public.c-source</string>
				<string>public.c-plus-plus-source</string>
				<string>public.objective-c-source</string>
				<string>public.c-header</string>
				<string>public.c-plus-plus-header</string>
				<string>com.sun.java-source</string>
				<!-- Config / structured text -->
				<string>public.json</string>
				<string>public.yaml</string>
				<string>public.xml</string>
				<string>com.apple.property-list</string>
			</array>
		</dict>
	</dict>
</dict>
</plist>
